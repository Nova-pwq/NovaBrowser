{
  "name": "novabrowser",
  "version": "1.0.0",
  "description": "NovaBrowser — один запит, три пошукові системи",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.0.0" },
  "build": {
    "appId": "com.nova.browser",
    "productName": "NovaBrowser",
    "files": ["main.js", "preload.js", "ide.js", "auth.js", "webview-preload.js", "index.html", "assets/**"],
    "win": { "target": "nsis", "icon": "assets/icon.png" },
    "mac": { "icon": "assets/icon.png" },
    "linux": { "target": "AppImage", "icon": "assets/icon.png" }
  }
}
